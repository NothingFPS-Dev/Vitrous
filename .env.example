# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# .env.local is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Data API
# "Project URL"  e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API Keys → the "anon / public" key.
# Safe to expose in the browser: Row Level Security controls what it can do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio → Get API key.   (Only needed for the engraving assistant;
# leave blank until that feature is switched on.)
GEMINI_API_KEY=

# Optional: pin a different Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=
